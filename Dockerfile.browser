FROM mcr.microsoft.com/playwright:v1.62.1-noble

ENV CI=1
WORKDIR /app

COPY tests/browser/package.json tests/browser/package-lock.json tests/browser/
RUN npm ci --prefix tests/browser

COPY . .

COPY tools/docker-test-entrypoint.sh /usr/local/bin/docker-test-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/docker-test-entrypoint \
    && chmod +x /usr/local/bin/docker-test-entrypoint \
    && mkdir -p \
        /app/test-results \
        /app/tests/browser/test-results \
        /app/tests/browser/playwright-report

ENTRYPOINT ["/usr/local/bin/docker-test-entrypoint"]
CMD ["npm", "--prefix", "tests/browser", "test", "--", "--grep-invert", "contrato visual do acesso"]
